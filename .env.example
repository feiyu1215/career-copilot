# Career Copilot — LLM Provider 环境变量配置
#
# 复制此文件为 .env 并填写你的配置：
#   cp .env.example .env
#
# 然后根据你使用的 Provider 填写对应值。

# ──────────────────────────────────────────────
# Provider 选择（friday / sub2api / nvidia）
# ──────────────────────────────────────────────
LLM_PROVIDER=friday

# ──────────────────────────────────────────────
# Provider: friday（OpenAI 兼容接口）
# ──────────────────────────────────────────────
LLM_BASE_URL=https://your-openai-compatible-endpoint.com/v1
FRIDAY_APP_ID=your-app-id-here

# ──────────────────────────────────────────────
# Provider: sub2api（外部 API 代理）
# ──────────────────────────────────────────────
SUB2API_BASE_URL=https://your-sub2api-endpoint.com/v1
SUB2API_API_KEY=sk-your-api-key-here

# ──────────────────────────────────────────────
# Provider: nvidia（OpenAI 兼容接口，托管 DeepSeek 等开源模型）
# ──────────────────────────────────────────────
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-nvidia-api-key-here

# ──────────────────────────────────────────────
# Provider: Agnes AI（外部可达，沙箱可用，CI 评估默认使用）
# ──────────────────────────────────────────────
AGNES_BASE_URL=
AGNES_API_KEY=

# ──────────────────────────────────────────────
# 可选：career_log.py 存储路径（默认 ~/.catpaw/career-copilot）
# ──────────────────────────────────────────────
# CAREER_COPILOT_DIR=~/.catpaw/career-copilot
